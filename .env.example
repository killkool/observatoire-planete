# Scope V1 (France). Leave unset or false.

ENABLE_GLOBAL_DATA=false
ENABLE_OCEAN=false
ENABLE_GLOBAL_SEARCH=false

# Cible production (ADR-0002). Laisser vide en local : SQLite data/meteo.sqlite.
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Cloudflare R2 (fichiers RAW / ERA5 France). Ne jamais coller de secret ici.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Téléchargement distant depuis le dashboard. Laisser false : l’UI ne frappe pas data.gouv.
# ALLOW_REMOTE_IMPORT=false
# IGN_TILE_CACHE_ONLY=true  # cartes uniquement depuis data/tiles (aucune tuile IGN manquante)

# ERA5 point extract (optional). Never commit secrets.
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=
